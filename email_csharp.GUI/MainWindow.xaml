<Window x:Class="email_csharp.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="E-Mail Manager - Chef-Ansicht" Height="750" Width="1250">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SPALTE 0: Linke Seite (Button + Kompakte Liste mit Papier-Anhängen) -->
        <Grid Grid.Column="0" Background="#FFF0F0F0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Abruf-Button -->
            <Button x:Name="BtnStartDownload" Grid.Row="0" Content="📥 E-Mails abrufen" 
                    Margin="10,10,5,10" Padding="10" Background="#FF007ACC" Foreground="White" 
                    FontWeight="Bold" Click="BtnStartDownload_Click"/>

            <!-- Kompakte E-Mail-Liste -->
            <ListView x:Name="EmailListView" Grid.Row="1" Margin="10,0,10,10" BorderBrush="#FFDDDDDD" 
                      SelectionChanged="EmailListView_SelectionChanged" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,8,4,8">
                            <TextBlock Text="{Binding Sender}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SenderEmail}" FontSize="11" Foreground="#FF0066CC" TextTrimming="CharacterEllipsis" Margin="0,1,0,1"/>
                            <TextBlock Text="{Binding Subject}" FontSize="11" Foreground="#FF555555" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                            <!-- Blatt-Papier-Kacheln für Anhänge -->
                            <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFFFF" BorderBrush="#FFB0C4DE" BorderThickness="1.5" CornerRadius="4" Padding="6,6" Margin="0,0,6,6" 
                                                Width="130" Height="48"
                                                ToolTip="{Binding}" MouseLeftButtonDown="Attachment_MouseLeftButtonDown" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Dokument-Symbol -->
                                                <TextBlock Text="📄" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                                <!-- Dateiname mit Zeilenumbruch -->
                                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="10" Foreground="#FF333333" FontWeight="SemiBold" 
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxHeight="36"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- SPALTE 1: Rechte Seite (Details, Eingabe & Vorschau) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Oben: Header-Info, Eingabefelder & Steuerungsbuttons -->
            <Border Grid.Row="0" Background="#FFF9F9F9" BorderBrush="#FFDDDDDD" BorderThickness="0,0,0,1" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Kopfzeile mit Betreff/Absender und rechts Einstellungen + Logs -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtSubject" Text="Betreff: (Keine E-Mail ausgewählt)" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSender" Text="Absender: -" FontSize="12" Foreground="#FF555555" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Rechte obere Ecke: Ablegen (abseits der Aktionsbuttons) sowie Einstellungen & Logs -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <!-- NEU: Ablegen im Archiv-Ordner, bewusst von Einsortieren/Blockieren/Löschen getrennt -->
                            <Button x:Name="BtnArchive" Content="📦 Ablegen" Width="95" Height="30" Margin="0,0,24,0"
                                    Background="#FF17A2B8" Foreground="White" FontWeight="Bold" Click="BtnArchive_Click"/>
                            <Button x:Name="BtnSettings" Content="⚙️ Einstellungen" Width="110" Height="30" Margin="0,0,8,0"
                                    Background="#FFE0E0E0" Foreground="#FF333333" FontWeight="Bold" Click="BtnSettings_Click"/>
                            <Button Content="📜 Logs" Width="90" Height="30" Click="BtnShowLogs_Click" FontWeight="Bold"
                                    Background="#FFE0E0E0" Foreground="#FF333333"/>
                        </StackPanel>
                    </Grid>

                    <!-- Eingabefelder: Auftragsnummer, Firma und Aktionsbuttons -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Auftragsnummer -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Auftragsnummer:" FontSize="11" FontWeight="Bold" Foreground="#FF333333" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtOrderNumber" Height="28" VerticalContentAlignment="Center" Padding="4"/>
                        </StackPanel>

                        <!-- Firmenordner Auswahl -->
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Firma / Ordner (Auto-Erkennung):" FontSize="11" FontWeight="Bold" Foreground="#FF333333" Margin="0,0,0,2"/>
                            <ComboBox x:Name="CmbCompany" IsEditable="True" Height="28" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Buttons rechts (Einsortieren, Ablegen, Blockieren & Löschen) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button x:Name="BtnAssign" Content="🚀 Einsortieren" Width="110" Height="28" Margin="0,0,6,0"
                                    Background="#FF28A745" Foreground="White" FontWeight="Bold" Click="BtnAssign_Click"/>
                            <Button x:Name="BtnBlockSender" Content="🚫 Blockieren" Width="100" Height="28" Margin="0,0,6,0"
                                    Background="#FFDC3545" Foreground="White" FontWeight="Bold" Click="BtnBlockSender_Click"/>
                            <Button x:Name="BtnDeleteOnly" Content="🗑️ Löschen" Width="95" Height="28" 
                                    Background="#FF6C757D" Foreground="White" FontWeight="Bold" Click="BtnDeleteOnly_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Mitte/Unten: WebView2 Vorschau -->
            <wv2:WebView2 x:Name="EmailWebView" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
