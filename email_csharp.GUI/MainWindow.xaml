<Window x:Class="email_csharp.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="E-Mail Organizer & Downloader" Height="650" Width="1000">

    <Grid>
        <!-- Das Layout wird in 3 Spalten unterteilt: Links Ordner, Mitte Liste, Rechts Vorschau -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Spalte 1: Linke Navigation (Ordner) -->
        <ListBox Grid.Column="0" Background="#FFF0F0F0" BorderBrush="#FFDDDDDD">
            <ListBoxItem Content="📥 Unsorted" FontWeight="Bold" IsSelected="True"/>
            <ListBoxItem Content="⚙️ Regeln / SQLite"/>
        </ListBox>

        <!-- Spalte 2: Mitte (Liste der E-Mails aus dem Unsorted-Ordner) -->
        <ListView x:Name="EmailListView" Grid.Column="1" BorderBrush="#FFDDDDDD" SelectionChanged="EmailListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Absender" DisplayMemberBinding="{Binding Sender}" Width="130"/>
                    <GridViewColumn Header="Datum" DisplayMemberBinding="{Binding Date}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Spalte 3: Rechts (E-Mail Vorschau über WebView2 für sauberes HTML) -->
        <wv2:WebView2 x:Name="EmailWebView" Grid.Column="2" />
    </Grid>
</Window>
